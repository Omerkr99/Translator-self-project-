# Copyrighted game/BIOS material -- never push these (PS1 BIOS ROM,
# the commercial game disc image, and third-party source of unclear
# provenance all live under this folder).
קיבצי דמה/

# Decoded/extracted game audio (WAV files) and other bulk-regeneratable
# exports (the full disc asset index, per-pack review folders) --
# copyrighted content and/or trivially regenerable from the real disc
# image via gcrts.audio_asset_resolver/gcrts.audio_review, never
# committed. The one exception is the human-confirmed semantic label
# store, which is real, non-audio, hand-authored project data --
# force-added explicitly, not covered by this ignore rule in practice.
audio_export/

# Leftover scratch/test-run artifacts from local test sessions (some are
# even permission-locked) -- not real project state.
asset_test_tmp/
asset_test_tmp_final/
asset_test_tmp_full/
asset_test_tmp_full2/
composite_tmp/
composite_tmp2/
gpu_full_tmp/
runtime_full_tmp/
snapshot_profile_tmp/
spoils_tmp/
test-temp-runtime-workflow/
test-temp-runtime-workflow-final/
visual_background_tmp/
visual_context_tmp/
visual_full_tmp/
visual_test_tmp/
visual_test_tmp2/
workflow_finish_tmp/
workflow_full_tmp/
.test-tmp/

# Python / tooling caches
__pycache__/
*.pyc
.pytest_cache/

# SPU Playback Trace: ephemeral per-session JSONL capture output
# produced by pcsx_lua/spu_playback_trace.lua while it's running
# against a live PCSX-Redux instance -- regeneratable by re-running the
# capture, never source. A specific capture kept as real evidence for
# a documented finding gets force-added explicitly, same precedent as
# audio_export/semantic_labels.json.
spu_playback_trace*.jsonl

# Audio Data Trace / CD Target Trace / Output Audio Capture: raw
# 2MB RAM snapshots (pcsx_lua/dump_ram.lua), GDB capture JSON logs
# (scripts/gdb_cdinit_trigger_capture.py), the regenerable audio
# fingerprint database, and this session's exploratory audio captures
# and extracted candidate WAVs -- all bulk, regeneratable by re-running
# the live capture, never source. Same precedent as audio_export/ and
# spu_playback_trace*.jsonl above.
artifacts/
audio_fingerprints.json
run0*_before.bin
run0*_during.bin
run0*_after.bin
control_before.bin
control_during.bin
control_after.bin
sanity.bin
watchpoint_lba_trigger.bin
cdinit_gdb_trigger.bin
watchpoint_sequence*.json
cd_command_sequence.json
spu_mmio_sequence.json
spu_transfer_fifo_sequence.json
spu_upload_run01.json
